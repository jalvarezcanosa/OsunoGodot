[sub_resource type="GDScript" id="GDScript_wuswk"]
script/source = "extends Light2D # O Sprite2D, Node2D, etc.

var velocidad = 500 # Velocidad de seguimiento

func _process(delta):
	# Obtener la posición del ratón
	var objetivo = get_global_mouse_position()
	
	# Moverse hacia el ratón suavemente
	# Si quieres movimiento instantáneo, usa: global_position = objetivo
	global_position = global_position.lerp(objetivo, velocidad * delta / 100)
"

