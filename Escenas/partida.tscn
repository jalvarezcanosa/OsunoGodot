[sub_resource type="GDScript" id="GDScript_5n3aw"]
script/source = "extends Control

@onready var grid := $\"Cartas usuario\"
@export var card_scene : PackedScene

func set_hand(cards : Array):
	for c in grid.get_children():
		c.queue_free()

	for card_code in cards:
		var card = card_scene.instantiate()
		card.set_card(card_code)
		card.card_clicked.connect(_on_card_clicked)
		grid.add_child(card)

func _on_card_clicked(card_code):
	get_parent().get_node(\"GameState\").play_card(card_code)
"

[sub_resource type="GDScript" id="GDScript_bnojs"]
script/source = "extends Control

@onready var grid := $GridContainer
@export var back_card_scene : PackedScene

func set_card_count(count : int):
	for c in grid.get_children():
		c.queue_free()

	for i in count:
		var card = back_card_scene.instantiate()
		grid.add_child(card)
"

[sub_resource type="GDScript" id="GDScript_dieh8"]
script/source = "extends Area2D

signal card_dropped(card)

func _on_area_entered(area):
	if area is Area2D and area.has_method(\"return_to_hand\"):
		emit_signal(\"card_dropped\", area)
"

